        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "example": {
                  "username": "your-username",
                  "password": "your-password"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token granted successfully"
          },
          "401": {
            "description": "Invalid credentials provided"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
