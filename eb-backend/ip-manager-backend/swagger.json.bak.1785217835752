      }
    },
    "schemas": {
      "Ticket": {
        "type": "object",
        "properties": {
          "reference_id": {
            "type": "string",
            "example": "T00010"
          },
          "client_id": {
            "type": "string",
            "nullable": true,
            "example": "EB-002"
          },
          "company_name": {
            "type": "string",
            "nullable": true,
            "description": "Derived from clients.client_name (read-only)"
          },
          "department": {
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          },
          "sales_agent": {
            "type": "string"
          },
          "connection_name": {
            "type": "string"
          },
          "assigned_user_id": {
            "type": "integer",
            "nullable": true
          },
          "assigned_role_id": {
            "type": "integer",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "Assigned",
              "In Progress",
              "Pending",
              "Resolved",
              "Closed",
              "Cancelled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TicketCreate": {
        "type": "object",
        "required": [
          "department",
          "phone_number",
          "sales_agent",
          "connection_name"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "nullable": true,
            "example": "EB-002"
          },
          "department": {
            "type": "string",
            "example": "IT"
          },
          "phone_number": {
            "type": "string",
            "example": "+96170000000"
          },
          "sales_agent": {
            "type": "string",
            "example": "John Doe"
          },
          "connection_name": {
            "type": "string",
            "example": "TRI001"
          }
        }
      },
      "TicketUpdate": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string",
            "nullable": true
          },
          "department": {
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          },
          "sales_agent": {
            "type": "string"
          },
          "connection_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Open",
              "Assigned",
              "In Progress",
              "Pending",
              "Resolved",
              "Closed",
              "Cancelled"
            ]
          }
        }
      },
      "LteDevice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "client_id": {
            "type": "string",
            "nullable": true,
            "example": "EB-002",
            "description": "FK to clients.id"
          },
          "device_vendor": {
            "type": "string"
          },
          "device_model": {
            "type": "string"
          },
          "device_serial": {
            "type": "string"
          },
          "imei": {
            "type": "string"
          },
          "carrier": {
            "type": "string"
          },
          "iccid": {
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          },
          "apn": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Spare",
              "Faulty",
              "Returned",
              "Decommissioned"
            ]
          },
          "install_location": {
            "type": "string"
          },
          "installed_at": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "notes": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
